# Cadeia de fallback de interpretação: tenta cada provedor abaixo na ordem
# (gratuitos primeiro) e só cai pra Anthropic (pago) se todos os outros
# falharem ou não estiverem configurados.
# ATENÇÃO (LGPD): este bot lida com nome de pacientes de terapia (dado
# sensível de saúde por associação, art. 5º, II). Cada mensagem interpretada
# é enviada ao provedor de IA da vez — avalie com a Raquel se os provedores
# gratuitos (Gemini/Groq/Mistral) são aceitáveis pra esse uso ou se prefere
# restringir a um provedor só (ex: ANTHROPIC_ONLY=true) antes de ligar em
# produção. O nome do paciente é a única informação de saúde que passa pela
# IA — o restante do prontuário nunca é lido por este bot.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Se true, ignora Gemini/Groq/Mistral/OpenAI e usa só a Anthropic (mais caro,
# mas evita mandar nome de paciente pra provedores gratuitos de terceiros).
ANTHROPIC_ONLY=false

# URL do projeto Supabase (raquel-frois-agenda) e service role key (Project
# Settings > API) — bypassa RLS.
SUPABASE_URL=https://soipxtrqzqmilpiblwcr.supabase.co
SUPABASE_SERVICE_KEY=

# Nome exato do grupo do WhatsApp a ser monitorado
NOME_GRUPO_ALVO=agenda

# Fuso horário usado nos lembretes automáticos
FUSO_HORARIO=America/Sao_Paulo

# Porta HTTP interna (healthcheck do Fly.io + endpoint /status)
PORT=8080
